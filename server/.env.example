# Copia questo file in ".env" e valorizza le variabili prima di avviare il server.
# NON committare mai il file ".env" reale (contiene segreti).

# Genera un secret lungo e casuale, ad esempio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=sostituiscimi_con_una_stringa_casuale_lunga

# In produzione imposta NODE_ENV=production: attiva i cookie "secure"
# (inviati solo via HTTPS).
NODE_ENV=development

PORT=3000

# Stringa di connessione al database PostgreSQL.
# In locale, se hai Postgres installato sul tuo computer, sarà qualcosa come:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/registro_cassa
# Per un database online gratuito (consigliato, anche solo per provare),
# crea un progetto su https://neon.tech o https://supabase.com: ti danno
# una stringa di connessione già pronta da incollare qui.
DATABASE_URL=postgresql://utente:password@host:5432/nome_database
